def make_card(invitation):
    colors = {
        "Royal Red & Gold": ("#720D24", "#E8C878"),
        "Elegant Green": ("#064E3B", "#D9C17A"),
        "Classic White": ("#FFFCF4", "#A98746"),
        "Royal Purple": ("#39224F", "#E3C779")
    }

    bg, gold = colors[style]

    img = Image.new("RGB", (900, 1200), bg)
    draw = ImageDraw.Draw(img)

    draw.rectangle(
        (28, 28, 872, 1172),
        outline=gold,
        width=5
    )
    draw.rectangle(
        (45, 45, 855, 1155),
        outline=gold,
        width=2
    )

    try:
        font_path = "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf"
        title_font = ImageFont.truetype(font_path, 43)
        body_font = ImageFont.truetype(font_path, 28)
        small_font = ImageFont.truetype(font_path, 25)
    except OSError:
        title_font = ImageFont.load_default()
        body_font = ImageFont.load_default()
        small_font = ImageFont.load_default()

    def centered(text, y, font, fill=gold):
        box = draw.textbbox((0, 0), text, font=font)
        width = box[2] - box[0]
        draw.text(((900 - width) / 2, y), text,
                  font=font, fill=fill)

    centered("YOU ARE INVITED", 100, title_font)

    y = 220
    for line in invitation.splitlines():
        for wrapped in textwrap.wrap(line, width=32) or [""]:
            centered(wrapped, y, body_font)
            y += 48

    y = max(y + 20, 650)
    centered(f"Date: {date}", y, small_font)
    centered(f"Time: {time}", y + 55, small_font)

    venue_lines = textwrap.wrap(f"Venue: {venue}", width=35)
    for i, line in enumerate(venue_lines):
        centered(line, y + 110 + i * 40, small_font)

    if family:
        centered("With love from", 930, small_font)
        for i, line in enumerate(textwrap.wrap(family, 32)):
            centered(line, 975 + i * 40, small_font)

    if message:
        for i, line in enumerate(textwrap.wrap(message, 35)):
            centered(line, 1070 + i * 35, small_font)

    return img


if st.button("✨ Generate AI Invitation", type="primary"):
    if not bride.strip() or not groom.strip() or not venue.strip():
        st.error("Please enter the bride, groom and venue.")
    else:
        with st.spinner("Creating your invitation..."):
            wording = create_invitation()
            card = make_card(wording)

        st.subheader("Invitation Preview")
        st.image(card, use_container_width=True)

        st.subheader("Invitation Text")
        st.text(wording)

        output = io.BytesIO()
        card.save(output, format="PNG")

        st.download_button(
            "⬇️ Download Invitation Card",
            data=output.getvalue(),
            file_name="wedding_invitation.png",
            mime="image/png"
        )
